PORT=3333
# Porta 5433 no host para não conflitar com um PostgreSQL instalado no Windows (veja docker-compose.yml)
DATABASE_URL="postgresql://docker:docker@localhost:5433/brevly"

# Credenciais do Cloudflare R2 (necessárias para o "Baixar CSV").
# Os valores abaixo são placeholders só para o servidor subir; substitua pelos reais.
CLOUDFLARE_ACCOUNT_ID="placeholder"
CLOUDFLARE_ACCESS_KEY_ID="placeholder"
CLOUDFLARE_SECRET_ACCESS_KEY="placeholder"
CLOUDFLARE_BUCKET="brevly"
CLOUDFLARE_PUBLIC_URL="https://placeholder.r2.dev"
